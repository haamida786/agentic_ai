class Agent:
    def __init__(self, name):
        self.name = name

    def send_message(self, receiver, message):
        print(f"{self.name} sends to {receiver.name}: {message}")
        receiver.receive_message(self.name, message)

    def receive_message(self, sender, message):
        print(f"{self.name} received from {sender}: {message}")
        print(f"{self.name}: Task acknowledged.\n")


# Main Program
agent1 = Agent("Agent A")
agent2 = Agent("Agent B")

message = input("Enter the message to communicate: ")
agent1.send_message(agent2, message)
